# Required
MONGO_URI=mongodb://127.0.0.1:27017/pluma
JWT_SECRET=replace-with-a-long-random-secret

# Recommended: separate encryption root for user-provided AI keys
AI_KEYS_ENCRYPTION_SECRET=replace-with-another-long-random-secret

# Server and browser origins
PORT=5000
CLIENT_URL=http://localhost:3000
# Comma-separated when more than one exact origin is allowed
# CLIENT_URLS=http://localhost:3000,https://pluma.example

# Optional Google sign-in (must match the client value)
GOOGLE_CLIENT_ID=

# Optional server-level AI fallbacks; users can instead supply BYOK keys in Settings
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional distributed services. Leave blank for in-process fallbacks.
REDIS_URL=
KAFKA_BROKERS=

# Required by Open Library etiquette for production traffic
OPEN_LIBRARY_USER_AGENT=Pluma/1.0 (contact: you@example.com)
